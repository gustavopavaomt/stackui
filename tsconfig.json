{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "types": [
      "vitest/globals",
      "node"
    ],
    "paths": {
      "@stackui/react": [
        "./src/index.ts"
      ],
      "@stackui/react/styles.css": [
        "./src/styles/index.css"
      ]
    }
  },
  "include": [
    "src",
    "demo",
    "vite.config.ts"
  ]
}
