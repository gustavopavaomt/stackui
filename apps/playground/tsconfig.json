{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "types": ["vite/client", "node"],
    "paths": {
      "@stackui/react": ["../../packages/react/src/index.ts"],
      "@stackui/react/styles.css": ["../../packages/react/src/styles/index.css"]
    }
  },
  "include": [".", "vite.config.ts"]
}
