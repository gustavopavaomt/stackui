{
  "name": "@stackui/react",
  "version": "0.0.0",
  "description": "Build dynamic and elegant PWA applications for iOS and Android with React.",
  "license": "MIT",
  "author": "Gustavo Pavao Barboza",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gustavopavaomt/stackui.git"
  },
  "homepage": "https://github.com/gustavopavaomt/stackui#readme",
  "bugs": "https://github.com/gustavopavaomt/stackui/issues",
  "keywords": [
    "react",
    "pwa",
    "ios",
    "android",
    "ui",
    "components",
    "mobile"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js"
    },
    "./barcode": {
      "types": "./dist/types/barcode.d.ts",
      "import": "./dist/barcode.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "module": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@zxing/browser": ">=0.1",
    "@zxing/library": ">=0.20",
    "react": ">=19",
    "react-dom": ">=19"
  },
  "peerDependenciesMeta": {
    "@zxing/browser": {
      "optional": true
    },
    "@zxing/library": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@zxing/browser": "^0.2.1",
    "@zxing/library": "^0.23.0",
    "jsdom": "^29.1.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
